# Application
APP_NAME=BankOS API
ENVIRONMENT=local
DOCS_ENABLED=true
LOG_LEVEL=INFO

# Database. SQLite lives in a local file; Docker uses the mounted /app/data volume.
DATABASE_URL=sqlite:///./data/bankos.db

# Authentication
JWT_SECRET_KEY=replace-this-with-a-long-random-value
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60

# HTTP
CORS_ORIGINS=http://localhost:8000,http://localhost:5173
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_FINANCIAL_PER_MINUTE=30
RATE_LIMIT_IP_PER_MINUTE=120
# Timeout in seconds for each webhook delivery attempt; must be greater than 0.
WEBHOOK_TIMEOUT_SECONDS=5
